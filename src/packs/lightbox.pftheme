{
  "format": "pifiles-theme",
  "version": 1,
  "id": "pifiles.lightbox",
  "name": "Lightbox",
  "author": "PiFiles",
  "description": "A bright, colour-neutral light table for reviewing prints and contact sheets.",
  "modes": {
    "light": {
      "--bg": "#fafafa",
      "--bg-2": "#f3f3f3",
      "--bg-3": "#ffffff",
      "--mica": "#f0f0f0",
      "--chrome": "rgba(255,255,255,.5)",
      "--surface": "#ffffff",
      "--surface-2": "#f3f3f3",
      "--surface-solid": "#ffffff",
      "--text": "#111111",
      "--text-2": "color-mix(in srgb, #111111 72%, transparent)",
      "--text-3": "color-mix(in srgb, #111111 50%, transparent)",
      "--border": "rgba(0,0,0,.07)",
      "--border-strong": "rgba(0,0,0,.12)",
      "--stroke": "rgba(0,0,0,.08)",
      "--hover": "rgba(0,0,0,.045)",
      "--pressed": "rgba(0,0,0,.03)",
      "--bg-hover": "rgba(0,0,0,.045)",
      "--bg-active": "rgba(0,0,0,.03)",
      "--accent": "#111111",
      "--accent-hover": "#111111",
      "--accent-text": "#111111",
      "--on-accent": "#ffffff",
      "--accent-bg": "color-mix(in srgb, #111111 11%, transparent)",
      "--sel": "color-mix(in srgb, #111111 13%, transparent)",
      "--sel-hover": "color-mix(in srgb, #111111 18%, transparent)",
      "--sel-text": "#111111",
      "--flyout": "color-mix(in srgb, #ffffff 95%, transparent)",
      "--card": "rgba(255,255,255,.7)",
      "--card-hover": "#ffffff",
      "--layer": "rgba(255,255,255,.5)",
      "--layer-2": "rgba(255,255,255,.7)"
    }
  },
  "css": ".file-row.selected, .file-card.selected { box-shadow: inset 0 0 0 1.5px #111 !important; }"
}