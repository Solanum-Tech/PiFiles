{
  "format": "pifiles-theme",
  "version": 1,
  "id": "pifiles.golden-hour",
  "name": "Golden Hour",
  "author": "PiFiles",
  "description": "Warm amber light, the hour before sunset.",
  "modes": {
    "dark": {
      "--bg": "#1a1410",
      "--bg-2": "#2a2019",
      "--bg-3": "#241b15",
      "--mica": "radial-gradient(1200px 700px at 0% 0%, rgba(245,166,35,.12), transparent 60%), #1a1410",
      "--chrome": "rgba(255,255,255,.025)",
      "--surface": "#201813",
      "--surface-2": "#2a2019",
      "--surface-solid": "#241b15",
      "--text": "#f6ead9",
      "--text-2": "color-mix(in srgb, #f6ead9 74%, transparent)",
      "--text-3": "color-mix(in srgb, #f6ead9 50%, transparent)",
      "--border": "rgba(255,255,255,.07)",
      "--border-strong": "rgba(255,255,255,.12)",
      "--stroke": "rgba(255,255,255,.07)",
      "--hover": "rgba(255,255,255,.06)",
      "--pressed": "rgba(255,255,255,.035)",
      "--bg-hover": "rgba(255,255,255,.06)",
      "--bg-active": "rgba(255,255,255,.04)",
      "--accent": "#f5a623",
      "--accent-hover": "#f5a623",
      "--accent-text": "#ffc35c",
      "--on-accent": "#2a1600",
      "--accent-bg": "color-mix(in srgb, #f5a623 16%, transparent)",
      "--sel": "color-mix(in srgb, #f5a623 20%, transparent)",
      "--sel-hover": "color-mix(in srgb, #f5a623 26%, transparent)",
      "--sel-text": "#f6ead9",
      "--flyout": "color-mix(in srgb, #241b15 94%, transparent)",
      "--card": "rgba(255,255,255,.04)",
      "--card-hover": "rgba(255,255,255,.07)",
      "--layer": "rgba(255,255,255,.03)",
      "--layer-2": "rgba(255,255,255,.05)"
    },
    "light": {
      "--bg": "#fbf5ec",
      "--bg-2": "#f6ede0",
      "--bg-3": "#fffcf7",
      "--mica": "#fbf5ec",
      "--chrome": "rgba(255,255,255,.5)",
      "--surface": "#fffaf3",
      "--surface-2": "#f6ede0",
      "--surface-solid": "#fffcf7",
      "--text": "#2b1d0e",
      "--text-2": "color-mix(in srgb, #2b1d0e 72%, transparent)",
      "--text-3": "color-mix(in srgb, #2b1d0e 50%, transparent)",
      "--border": "rgba(0,0,0,.07)",
      "--border-strong": "rgba(0,0,0,.12)",
      "--stroke": "rgba(0,0,0,.08)",
      "--hover": "rgba(0,0,0,.045)",
      "--pressed": "rgba(0,0,0,.03)",
      "--bg-hover": "rgba(0,0,0,.045)",
      "--bg-active": "rgba(0,0,0,.03)",
      "--accent": "#c26a00",
      "--accent-hover": "#c26a00",
      "--accent-text": "#a65a00",
      "--on-accent": "#ffffff",
      "--accent-bg": "color-mix(in srgb, #c26a00 11%, transparent)",
      "--sel": "color-mix(in srgb, #c26a00 13%, transparent)",
      "--sel-hover": "color-mix(in srgb, #c26a00 18%, transparent)",
      "--sel-text": "#2b1d0e",
      "--flyout": "color-mix(in srgb, #fffcf7 95%, transparent)",
      "--card": "rgba(255,255,255,.7)",
      "--card-hover": "#ffffff",
      "--layer": "rgba(255,255,255,.5)",
      "--layer-2": "rgba(255,255,255,.7)"
    }
  }
}