{
  "format": "pifiles-theme",
  "version": 1,
  "id": "pifiles.darkroom",
  "name": "Darkroom",
  "author": "PiFiles",
  "description": "Pure neutral greys that never tint your photos, with a safelight-red accent.",
  "radius": {
    "control": 4,
    "card": 6,
    "dialog": 8
  },
  "modes": {
    "dark": {
      "--bg": "#121212",
      "--bg-2": "#1d1d1d",
      "--bg-3": "#1a1a1a",
      "--mica": "#121212",
      "--chrome": "rgba(255,255,255,.025)",
      "--surface": "#161616",
      "--surface-2": "#1d1d1d",
      "--surface-solid": "#1a1a1a",
      "--text": "#e6e6e6",
      "--text-2": "color-mix(in srgb, #e6e6e6 74%, transparent)",
      "--text-3": "color-mix(in srgb, #e6e6e6 50%, transparent)",
      "--border": "rgba(255,255,255,.07)",
      "--border-strong": "rgba(255,255,255,.12)",
      "--stroke": "rgba(255,255,255,.07)",
      "--hover": "rgba(255,255,255,.06)",
      "--pressed": "rgba(255,255,255,.035)",
      "--bg-hover": "rgba(255,255,255,.06)",
      "--bg-active": "rgba(255,255,255,.04)",
      "--accent": "#e0443b",
      "--accent-hover": "#e0443b",
      "--accent-text": "#ff7a70",
      "--on-accent": "#ffffff",
      "--accent-bg": "color-mix(in srgb, #e0443b 16%, transparent)",
      "--sel": "color-mix(in srgb, #e0443b 20%, transparent)",
      "--sel-hover": "color-mix(in srgb, #e0443b 26%, transparent)",
      "--sel-text": "#e6e6e6",
      "--flyout": "color-mix(in srgb, #1a1a1a 94%, transparent)",
      "--card": "rgba(255,255,255,.04)",
      "--card-hover": "rgba(255,255,255,.07)",
      "--layer": "rgba(255,255,255,.03)",
      "--layer-2": "rgba(255,255,255,.05)"
    },
    "light": {
      "--bg": "#e9e9e9",
      "--bg-2": "#ececec",
      "--bg-3": "#f7f7f7",
      "--mica": "#e9e9e9",
      "--chrome": "rgba(255,255,255,.5)",
      "--surface": "#f4f4f4",
      "--surface-2": "#ececec",
      "--surface-solid": "#f7f7f7",
      "--text": "#161616",
      "--text-2": "color-mix(in srgb, #161616 72%, transparent)",
      "--text-3": "color-mix(in srgb, #161616 50%, transparent)",
      "--border": "rgba(0,0,0,.07)",
      "--border-strong": "rgba(0,0,0,.12)",
      "--stroke": "rgba(0,0,0,.08)",
      "--hover": "rgba(0,0,0,.045)",
      "--pressed": "rgba(0,0,0,.03)",
      "--bg-hover": "rgba(0,0,0,.045)",
      "--bg-active": "rgba(0,0,0,.03)",
      "--accent": "#c62f27",
      "--accent-hover": "#c62f27",
      "--accent-text": "#b3241d",
      "--on-accent": "#ffffff",
      "--accent-bg": "color-mix(in srgb, #c62f27 11%, transparent)",
      "--sel": "color-mix(in srgb, #c62f27 13%, transparent)",
      "--sel-hover": "color-mix(in srgb, #c62f27 18%, transparent)",
      "--sel-text": "#161616",
      "--flyout": "color-mix(in srgb, #f7f7f7 95%, transparent)",
      "--card": "rgba(255,255,255,.7)",
      "--card-hover": "#ffffff",
      "--layer": "rgba(255,255,255,.5)",
      "--layer-2": "rgba(255,255,255,.7)"
    }
  },
  "css": ".file-card .f-thumb img { box-shadow: 0 0 0 1px rgba(255,255,255,.08); }"
}