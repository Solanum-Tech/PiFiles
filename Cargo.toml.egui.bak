[package]
name = "file_explorer"
version = "0.1.0"
edition = "2024"

[dependencies]
egui = "0.28"
eframe = "0.28"
winapi = { version = "0.3", features = ["winnt", "winuser", "fileapi", "handleapi", "minwinbase", "sysinfoapi"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
walkdir = "2.3"
