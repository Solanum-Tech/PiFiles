{
  "format": "pifiles-theme",
  "version": 1,
  "id": "pifiles.blue-hour",
  "name": "Blue Hour",
  "author": "PiFiles",
  "description": "Deep twilight blues, the quiet minutes after sunset.",
  "modes": {
    "dark": {
      "--bg": "#0c1220",
      "--bg-2": "#172238",
      "--bg-3": "#131d31",
      "--mica": "radial-gradient(1200px 700px at 100% 0%, rgba(106,168,255,.14), transparent 60%), #0c1220",
      "--chrome": "rgba(255,255,255,.025)",
      "--surface": "#111a2c",
      "--surface-2": "#172238",
      "--surface-solid": "#131d31",
      "--text": "#e6eeff",
      "--text-2": "color-mix(in srgb, #e6eeff 74%, transparent)",
      "--text-3": "color-mix(in srgb, #e6eeff 50%, transparent)",
      "--border": "rgba(255,255,255,.07)",
      "--border-strong": "rgba(255,255,255,.12)",
      "--stroke": "rgba(255,255,255,.07)",
      "--hover": "rgba(255,255,255,.06)",
      "--pressed": "rgba(255,255,255,.035)",
      "--bg-hover": "rgba(255,255,255,.06)",
      "--bg-active": "rgba(255,255,255,.04)",
      "--accent": "#6aa8ff",
      "--accent-hover": "#6aa8ff",
      "--accent-text": "#94c0ff",
      "--on-accent": "#071a3a",
      "--accent-bg": "color-mix(in srgb, #6aa8ff 16%, transparent)",
      "--sel": "color-mix(in srgb, #6aa8ff 20%, transparent)",
      "--sel-hover": "color-mix(in srgb, #6aa8ff 26%, transparent)",
      "--sel-text": "#e6eeff",
      "--flyout": "color-mix(in srgb, #131d31 94%, transparent)",
      "--card": "rgba(255,255,255,.04)",
      "--card-hover": "rgba(255,255,255,.07)",
      "--layer": "rgba(255,255,255,.03)",
      "--layer-2": "rgba(255,255,255,.05)"
    },
    "light": {
      "--bg": "#eef3fb",
      "--bg-2": "#e6edf8",
      "--bg-3": "#fbfdff",
      "--mica": "#eef3fb",
      "--chrome": "rgba(255,255,255,.5)",
      "--surface": "#f7faff",
      "--surface-2": "#e6edf8",
      "--surface-solid": "#fbfdff",
      "--text": "#0e1a33",
      "--text-2": "color-mix(in srgb, #0e1a33 72%, transparent)",
      "--text-3": "color-mix(in srgb, #0e1a33 50%, transparent)",
      "--border": "rgba(0,0,0,.07)",
      "--border-strong": "rgba(0,0,0,.12)",
      "--stroke": "rgba(0,0,0,.08)",
      "--hover": "rgba(0,0,0,.045)",
      "--pressed": "rgba(0,0,0,.03)",
      "--bg-hover": "rgba(0,0,0,.045)",
      "--bg-active": "rgba(0,0,0,.03)",
      "--accent": "#2563eb",
      "--accent-hover": "#2563eb",
      "--accent-text": "#1d4fc4",
      "--on-accent": "#ffffff",
      "--accent-bg": "color-mix(in srgb, #2563eb 11%, transparent)",
      "--sel": "color-mix(in srgb, #2563eb 13%, transparent)",
      "--sel-hover": "color-mix(in srgb, #2563eb 18%, transparent)",
      "--sel-text": "#0e1a33",
      "--flyout": "color-mix(in srgb, #fbfdff 95%, transparent)",
      "--card": "rgba(255,255,255,.7)",
      "--card-hover": "#ffffff",
      "--layer": "rgba(255,255,255,.5)",
      "--layer-2": "rgba(255,255,255,.7)"
    }
  }
}